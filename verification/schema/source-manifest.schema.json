{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sotch-pr35mac/hsk/verification/schema/source-manifest.schema.json",
  "title": "HSK independent verification source manifest",
  "type": "object",
  "required": ["schema_version", "retrieval_date", "policy", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "retrieval_date": {"type": "string", "format": "date"},
    "policy": {"type": "object"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "name", "dataset", "provider", "landing_url", "claimed_edition", "last_update", "revision", "license", "derivation", "expected", "artifacts"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 1},
        "dataset": {"enum": ["hsk_2015_exam", "proficiency_standard_2021", "hsk_exam_syllabus_2025"]},
        "provider": {"type": "string", "minLength": 1},
        "repository_url": {"type": ["string", "null"]},
        "landing_url": {"type": "string", "format": "uri"},
        "claimed_edition": {"type": "string", "minLength": 1},
        "last_update": {"type": "string", "minLength": 1},
        "revision": {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": {"enum": ["git_commit", "http_artifact_sha256"]},
            "value": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"}
          },
          "additionalProperties": false
        },
        "license": {
          "type": "object",
          "required": ["spdx", "name", "url", "redistribution"],
          "properties": {
            "spdx": {"type": ["string", "null"]},
            "name": {"type": "string"},
            "url": {"type": "string", "format": "uri"},
            "redistribution": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "derivation": {
          "type": "object",
          "required": ["method", "upstream_authoritative_url", "same_authoritative_source", "independence_class", "limitations"],
          "properties": {
            "method": {"type": "string"},
            "upstream_authoritative_url": {"type": "string", "format": "uri"},
            "same_authoritative_source": {"type": "boolean"},
            "independence_class": {"type": "string"},
            "limitations": {"type": "string"}
          },
          "additionalProperties": false
        },
        "expected": {
          "type": "object",
          "required": ["source_records", "classification_assignments", "counts_by_level"],
          "properties": {
            "source_records": {"type": ["integer", "null"], "minimum": 0},
            "classification_assignments": {"type": ["integer", "null"], "minimum": 0},
            "counts_by_level": {
              "type": ["object", "null"],
              "propertyNames": {"enum": ["1", "2", "3", "4", "5", "6", "7-9"]},
              "additionalProperties": {"type": "integer", "minimum": 0}
            }
          },
          "additionalProperties": false
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["url", "repository_path", "sha256", "format", "adapter"],
            "properties": {
              "url": {"type": "string", "format": "uri"},
              "repository_path": {"type": ["string", "null"]},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "format": {"type": "string"},
              "adapter": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
