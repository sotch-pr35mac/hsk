{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "corrections": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "action": { "const": "replace_fields" } } },
            "then": { "required": ["source_locator", "fields"] }
          },
          {
            "if": { "properties": { "action": { "const": "exclude" } } },
            "then": { "required": ["source_locator"] }
          },
          {
            "if": { "properties": { "action": { "const": "insert" } } },
            "then": { "required": ["source_locator", "fields"] }
          }
        ],
        "properties": {
          "action": { "enum": ["replace_fields", "exclude", "insert"] },
          "evidence": { "minLength": 1, "type": "string" },
          "fields": {
            "additionalProperties": false,
            "properties": {
              "extraction_method": { "type": "string" },
              "level": { "type": "string" },
              "part_of_speech_raw": { "type": "string" },
              "pinyin_raw": { "type": "string" },
              "simplified": { "type": "string" },
              "source_id": { "type": "string" },
              "source_sequence": { "type": "string" },
              "traditional": { "type": "string" }
            },
            "type": "object"
          },
          "id": { "pattern": "^[a-z0-9][a-z0-9._-]+$", "type": "string" },
          "reason": { "minLength": 1, "type": "string" },
          "source_id": { "enum": ["hsk2015", "proficiency2021", "hsk_exam2025"] },
          "source_locator": { "minLength": 1, "type": "string" }
        },
        "required": ["id", "source_id", "action", "reason", "evidence"],
        "type": "object"
      },
      "type": "array"
    },
    "notes": { "items": { "type": "string" }, "type": "array" },
    "schema_version": { "const": 1 }
  },
  "required": ["schema_version", "corrections"],
  "title": "HSK authoritative extraction correction ledger",
  "type": "object"
}
